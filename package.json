{
  "name": "@dreamer/dweb",
  "version": "3.1.2",
  "description": "A full-stack Web framework compatible with Deno and Bun, integrating @dreamer/* libraries for an out-of-the-box development experience.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/shuliangfu/dreamer-jsr.git"
  },
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./setup": "./src/setup.ts",
    "./types": "./src/types/mod.ts",
    "./core/app": "./src/core/app.ts",
    "./core/config": "./src/core/config.ts",
    "./core/service": "./src/core/service.ts",
    "./core/middleware": "./src/core/middleware.ts",
    "./core/plugin": "./src/core/plugin.ts",
    "./core/lifecycle": "./src/core/lifecycle.ts",
    "./core/database": "./src/core/database.ts",
    "./feature/server": "./src/feature/server.ts",
    "./feature/router": "./src/feature/router.ts",
    "./feature/render": "./src/feature/render.ts",
    "./feature/build": "./src/feature/build.ts",
    "./feature/command": "./src/feature/command.ts",
    "./feature/socket-io": "./src/feature/socket-io.ts",
    "./feature/websocket": "./src/feature/websocket.ts"
  },
  "scripts": {
    "setup": "deno run -A src/setup.ts",
    "check": "deno check src/ tests/",
    "test": "bun test tests/",
    "test:e2e": "deno test -A tests/e2e/"
  },
  "workspaces": [
    "examples/*/basic",
    "examples/*/advanced"
  ],
  "dependencies": {
    "@dreamer/dweb": "file:../dweb",
    "@dreamer/config": "npm:@jsr/dreamer__config@^1.0.1",
    "@dreamer/console": "npm:@jsr/dreamer__console@^1.0.12",
    "@dreamer/database": "npm:@jsr/dreamer__database@^1.0.8",
    "@dreamer/esbuild": "npm:@jsr/dreamer__esbuild@^1.0.40",
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@1.0.1",
    "@dreamer/image": "npm:@jsr/dreamer__image@^1.0.2",
    "@dreamer/lifecycle": "npm:@jsr/dreamer__lifecycle@^1.0.2",
    "@dreamer/logger": "npm:@jsr/dreamer__logger@^1.0.3",
    "@dreamer/middleware": "npm:@jsr/dreamer__middleware@^1.0.2",
    "@dreamer/middlewares": "npm:@jsr/dreamer__middlewares@^1.0.4",
    "@dreamer/plugin": "npm:@jsr/dreamer__plugin@^1.0.2",
    "@dreamer/plugins": "npm:@jsr/dreamer__plugins@^1.0.8",
    "@dreamer/render": "npm:@jsr/dreamer__render@^1.1.0",
    "@dreamer/router": "npm:@jsr/dreamer__router@^1.0.16",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.0.18",
    "@dreamer/server": "npm:@jsr/dreamer__server@^1.0.9",
    "@dreamer/service": "npm:@jsr/dreamer__service@^1.0.2",
    "@dreamer/session": "npm:@jsr/dreamer__session@^1.0.4",
    "@dreamer/socket-io": "npm:@jsr/dreamer__socket-io@^1.0.12",
    "@dreamer/utils": "npm:@jsr/dreamer__utils@^1.0.1",
    "@dreamer/view": "npm:@jsr/dreamer__view@^1.1.3",
    "@dreamer/websocket": "npm:@jsr/dreamer__websocket@^1.0.6",
    "autoprefixer": "10.4.19",
    "chart.js": "npm:chart.js@4.5.1",
    "cssnano": "7.0.3",
    "lightningcss": "1.31.1",
    "postcss": "8.4.39",
    "preact": "10.28.3",
    "preact-render-to-string": "6.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "scheduler": "0.27.0",
    "tailwindcss": "4.2.0"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.0.15"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "keywords": [
    "dweb",
    "framework",
    "full-stack",
    "deno",
    "bun",
    "react",
    "preact",
    "view",
    "dreamer"
  ]
}
