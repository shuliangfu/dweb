{
  "name": "@dreamer/dweb",
  "version": "3.0.71",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./setup": "./src/setup.ts",
    "./types": "./src/types/mod.ts",
    "./core/app": "./src/core/app.ts",
    "./core/config": "./src/core/config.ts",
    "./core/service": "./src/core/service.ts",
    "./core/middleware": "./src/core/middleware.ts",
    "./core/plugin": "./src/core/plugin.ts",
    "./core/lifecycle": "./src/core/lifecycle.ts",
    "./core/database": "./src/core/database.ts",
    "./feature/server": "./src/feature/server.ts",
    "./feature/router": "./src/feature/router.ts",
    "./feature/render": "./src/feature/render.ts",
    "./feature/build": "./src/feature/build.ts",
    "./feature/command": "./src/feature/command.ts",
    "./feature/socket-io": "./src/feature/socket-io.ts",
    "./feature/websocket": "./src/feature/websocket.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/locales/**/*.json",
      "LICENSE.md",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**",
      "**/examples/**",
      "**/docs/**"
    ]
  },
  "imports": {
    "@dreamer/config": "jsr:@dreamer/config@^1.0.0",
    "@dreamer/console": "jsr:@dreamer/console@^1.0.6",
    "@dreamer/database": "jsr:@dreamer/database@^1.0.2",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.0.4",
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.0.0",
    "@dreamer/image": "jsr:@dreamer/image@^1.0.0-beta.3",
    "@dreamer/lifecycle": "jsr:@dreamer/lifecycle@^1.0.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.0.0",
    "@dreamer/middleware": "jsr:@dreamer/middleware@^1.0.0",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.0.0",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.0.0",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.0.4",
    "@dreamer/render": "jsr:@dreamer/render@^1.0.10",
    "@dreamer/router": "jsr:@dreamer/router@^1.0.6",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.4",
    "@dreamer/server": "jsr:@dreamer/server@^1.0.1",
    "@dreamer/service": "jsr:@dreamer/service@^1.0.0",
    "@dreamer/socket-io": "jsr:@dreamer/socket-io@^1.0.3",
    "@dreamer/test": "jsr:@dreamer/test@^1.0.2",
    "@dreamer/utils": "jsr:@dreamer/utils@^1.0.0",
    "@dreamer/websocket": "jsr:@dreamer/websocket@^1.0.1",

    "preact": "npm:preact@10.28.0",
    "react": "npm:react@18.3.1",
    "esbuild": "npm:esbuild@0.27.2",
    "postcss": "npm:postcss@8.4.39",
    "autoprefixer": "npm:autoprefixer@10.4.19",
    "cssnano": "npm:cssnano@7.0.3"
  },
  "tasks": {
    "setup": "deno run -A src/setup.ts",
    "check": "deno check src/ tests/",
    "test": "deno test -A tests/",
    "test:e2e": "deno test -A tests/e2e/"
  },
  "workspace": [
    "./examples/preact-csr/basic",
    "./examples/preact-csr/advanced",
    "./examples/preact-hybrid/basic",
    "./examples/preact-hybrid/advanced",
    "./examples/preact-hybrid-flat/basic",
    "./examples/preact-hybrid-flat/advanced",
    "./examples/preact-hybrid-unocss/basic",
    "./examples/preact-hybrid-unocss/advanced",
    "./examples/preact-ssg/basic",
    "./examples/preact-ssg/advanced",
    "./examples/preact-ssr/basic",
    "./examples/preact-ssr/advanced",
    "./examples/react-csr/basic",
    "./examples/react-csr/advanced",
    "./examples/react-hybrid/basic",
    "./examples/react-hybrid/advanced",
    "./examples/react-hybrid-flat/basic",
    "./examples/react-hybrid-flat/advanced",
    "./examples/react-ssg/basic",
    "./examples/react-ssg/advanced",
    "./examples/react-ssr/basic",
    "./examples/react-ssr/advanced"
  ],
  "nodeModulesDir": "auto",
  "exclude": [
    "examples/",
    "tests/data/"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:better-sqlite3@11.10.0",
      "npm:esbuild@0.27.2",
      "npm:puppeteer@24.36.1"
    ]
  }
}
