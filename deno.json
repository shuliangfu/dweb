{
  "name": "@dreamer/dweb",
  "version": "3.7.0",
  "description": "A full-stack Web framework compatible with Deno and Bun, integrating @dreamer/* libraries for an out-of-the-box development experience.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./setup": "./src/setup.ts",
    "./types": "./src/types/mod.ts",
    "./core/app": "./src/core/app.ts",
    "./core/config": "./src/core/config.ts",
    "./core/service": "./src/core/service.ts",
    "./core/middleware": "./src/core/middleware.ts",
    "./core/plugin": "./src/core/plugin.ts",
    "./core/lifecycle": "./src/core/lifecycle.ts",
    "./core/database": "./src/core/database.ts",
    "./feature/server": "./src/feature/server.ts",
    "./feature/router": "./src/feature/router.ts",
    "./feature/render": "./src/feature/render.ts",
    "./feature/build": "./src/feature/build.ts",
    "./feature/command": "./src/feature/command.ts",
    "./feature/socket-io": "./src/feature/socket-io.ts",
    "./feature/websocket": "./src/feature/websocket.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/locales/**/*.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**",
      "**/examples/**",
      "**/docs/**"
    ]
  },
  "imports": {
    "@dreamer/config": "jsr:@dreamer/config@^1.1.0",
    "@dreamer/console": "jsr:@dreamer/console@^1.1.0",
    "@dreamer/database": "jsr:@dreamer/database@^1.2.0",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.3.0",
    "esbuild": "jsr:@dreamer/esbuild@^1.3.0",
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/lifecycle": "jsr:@dreamer/lifecycle@^1.1.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/middleware": "jsr:@dreamer/middleware@^1.1.0",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.1.0",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.1.0",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.2.0",
    "@dreamer/render": "jsr:@dreamer/render@^1.3.0",
    "@dreamer/router": "jsr:@dreamer/router@^1.2.1",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/server": "jsr:@dreamer/server@^1.2.1",
    "@dreamer/session": "jsr:@dreamer/session@^1.1.0",
    "@dreamer/service": "jsr:@dreamer/service@^1.1.0",
    "@dreamer/socket-io": "jsr:@dreamer/socket-io@^1.2.1",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "@dreamer/utils": "jsr:@dreamer/utils@^1.1.0",
    "@dreamer/view": "jsr:@dreamer/view@^2.2.0",
    "@dreamer/websocket": "jsr:@dreamer/websocket@^1.1.0",
    "playwright": "npm:playwright@1.59.1",
    "preact": "npm:preact@^10.29.8",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "react": "npm:react@^19.2.8",
    "react-dom": "npm:react-dom@^19.2.8",
    "scheduler": "npm:scheduler@^0.27.0",
    "postcss": "npm:postcss@^8.5.26",
    "autoprefixer": "npm:autoprefixer@^10.5.4",
    "cssnano": "npm:cssnano@^7.1.9"
  },
  "tasks": {
    "setup": "deno run -A src/setup.ts",
    "check": "deno check src/ tests/",
    "test": "deno test -A tests/",
    "test:unit": "deno test -A tests/unit/",
    "test:node": "node test-node.mjs",
    "test:node:e2e": "node test-node-e2e.mjs",
    "test:e2e": "deno test -A tests/e2e/",
    "pw:install": "npx -y playwright@1.59.1 install chromium"
  },
  "minimumDependencyAge": 0,
  "workspace": [
    "./examples/*/*",
    "./tests/data/dweb-integration-*"
  ],
  "nodeModulesDir": "auto",
  "exclude": [
    "examples/",
    "tests/data/"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  }
}
