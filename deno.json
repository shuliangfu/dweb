{
  "name": "@dreamer/dweb",
  "version": "3.0.92",
  "description": "A full-stack Web framework compatible with Deno and Bun, integrating @dreamer/* libraries for an out-of-the-box development experience.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts",
    "./setup": "./src/setup.ts",
    "./types": "./src/types/mod.ts",
    "./core/app": "./src/core/app.ts",
    "./core/config": "./src/core/config.ts",
    "./core/service": "./src/core/service.ts",
    "./core/middleware": "./src/core/middleware.ts",
    "./core/plugin": "./src/core/plugin.ts",
    "./core/lifecycle": "./src/core/lifecycle.ts",
    "./core/database": "./src/core/database.ts",
    "./feature/server": "./src/feature/server.ts",
    "./feature/router": "./src/feature/router.ts",
    "./feature/render": "./src/feature/render.ts",
    "./feature/build": "./src/feature/build.ts",
    "./feature/command": "./src/feature/command.ts",
    "./feature/socket-io": "./src/feature/socket-io.ts",
    "./feature/websocket": "./src/feature/websocket.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/locales/**/*.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**",
      "**/examples/**",
      "**/docs/**"
    ]
  },
  "imports": {
    "@dreamer/config": "jsr:@dreamer/config@^1.0.1",
    "@dreamer/console": "jsr:@dreamer/console@^1.0.12",
    "@dreamer/database": "jsr:@dreamer/database@^1.0.8",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.0.40",
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.0.1",
    "@dreamer/image": "jsr:@dreamer/image@^1.0.2",
    "@dreamer/lifecycle": "jsr:@dreamer/lifecycle@^1.0.2",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.0.2",
    "@dreamer/middleware": "jsr:@dreamer/middleware@^1.0.2",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.0.3",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.0.2",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.0.7",
    "@dreamer/render": "jsr:@dreamer/render@^1.0.40",
    "@dreamer/router": "jsr:@dreamer/router@^1.0.15",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.17",
    "@dreamer/server": "jsr:@dreamer/server@^1.0.9",
    "@dreamer/session": "jsr:@dreamer/session@^1.0.4",
    "@dreamer/service": "jsr:@dreamer/service@^1.0.2",
    "@dreamer/socket-io": "jsr:@dreamer/socket-io@^1.0.12",
    "@dreamer/test": "jsr:@dreamer/test@^1.0.15",
    "@dreamer/utils": "jsr:@dreamer/utils@^1.0.1",
    "@dreamer/view": "jsr:@dreamer/view@^1.1.0",
    "@dreamer/websocket": "jsr:@dreamer/websocket@^1.0.6",
    "preact": "npm:preact@10.28.3",
    "preact-render-to-string": "npm:preact-render-to-string@6.2.0",
    "react": "npm:react@19.2.4",
    "react-dom": "npm:react-dom@19.2.4",
    "scheduler": "npm:scheduler@0.27.0",
    "postcss": "npm:postcss@8.4.39",
    "autoprefixer": "npm:autoprefixer@10.4.19",
    "cssnano": "npm:cssnano@7.0.3"
  },
  "tasks": {
    "setup": "deno run -A src/setup.ts",
    "check": "deno check src/ tests/",
    "test": "deno test -A tests/",
    "test:e2e": "deno test -A tests/e2e/"
  },
  "workspace": [
    "./examples/*/*"
  ],
  "nodeModulesDir": "auto",
  "exclude": [
    "examples/",
    "tests/data/"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  }
}
