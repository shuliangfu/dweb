{
  "tasks": {
    "dev:backend": "deno run -A backend/main.ts",
    "dev:frontend": "deno run -A frontend/main.ts",
    "build:backend": "deno run -A backend/main.ts --build",
    "build:frontend": "deno run -A frontend/main.ts --build",
    "start:backend": "DWEB_LOG_FORMAT=text deno run -A dist/backend/server.js",
    "start:frontend": "deno run -A dist/frontend/server.js"
  },
  "imports": {
    "@common/": "./common/",
    "@backend/": "./backend/",
    "@frontend/": "./frontend/",
    "@dreamer/dweb": "../../../src/mod.ts",
    "@dreamer/config": "jsr:@dreamer/config@^1.1.1",
    "@dreamer/console": "jsr:@dreamer/console@^1.1.2",
    "@dreamer/database": "jsr:@dreamer/database@^1.3.0",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.5.4",
    "@dreamer/lifecycle": "jsr:@dreamer/lifecycle@^1.1.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.1",
    "@dreamer/middleware": "jsr:@dreamer/middleware@^1.1.0",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.1.1",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.1.1",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.2.9",
    "@dreamer/render": "jsr:@dreamer/render@^1.5.6",
    "@dreamer/router": "jsr:@dreamer/router@^1.2.3",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.3",
    "@dreamer/server": "jsr:@dreamer/server@^1.3.5",
    "@dreamer/service": "jsr:@dreamer/service@^1.1.0",
    "@dreamer/utils": "jsr:@dreamer/utils@^1.1.0",
    "preact": "npm:preact@^11.2.0",
    "preact/hooks": "npm:preact@^11.2.0/hooks",
    "preact/jsx-runtime": "npm:preact@^11.2.0/jsx-runtime",
    "preact-render-to-string": "npm:preact-render-to-string@6.8.3",
    "postcss": "npm:postcss@^8.5.33",
    "autoprefixer": "npm:autoprefixer@^10.7.0",
    "cssnano": "npm:cssnano@^9.9.0",
    "tailwindcss": "npm:tailwindcss@4.3.5",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@4.3.5",
    "esbuild": "npm:esbuild@0.28.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
