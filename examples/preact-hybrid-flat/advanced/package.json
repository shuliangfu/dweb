{
  "name": "dweb-example-preact-hybrid-flat-advanced",
  "description": "Dweb example (multi-app). Bun: bun run dev:backend | dev:frontend | build:backend | build:frontend | start:backend | start:frontend",
  "private": true,
  "scripts": {
    "dev:backend": "bun run backend/main.ts",
    "dev:frontend": "bun run frontend/main.ts",
    "build:backend": "bun run backend/main.ts --build",
    "build:frontend": "bun run frontend/main.ts --build",
    "start:backend": "bun run dist/backend/server.js",
    "start:frontend": "bun run dist/frontend/server.js"
  },
  "dependencies": {
    "@dreamer/dweb": "file:../../../",
    "lightningcss": "1.31.1",
    "tailwindcss": "4.2.0"
  }
}
