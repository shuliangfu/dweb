{
  "tasks": {
    "dev:backend": "deno run -A backend/main.ts",
    "dev:frontend": "deno run -A frontend/main.ts",
    "build:backend": "deno run -A backend/main.ts --build",
    "build:frontend": "deno run -A frontend/main.ts --build",
    "start:backend": "deno run -A dist/backend/server.js",
    "start:frontend": "deno run -A dist/frontend/server.js"
  },
  "imports": {
    "@common/": "./common/",
    "@backend/": "./backend/",
    "@frontend/": "./frontend/",
    "@dreamer/dweb": "../../../src/mod.ts",
    "@dreamer/config": "jsr:@dreamer/config@^1.1.1",
    "@dreamer/console": "jsr:@dreamer/console@^1.1.1",
    "@dreamer/database": "jsr:@dreamer/database@^1.2.0",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.5.0",
    "@dreamer/lifecycle": "jsr:@dreamer/lifecycle@^1.1.0",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/middleware": "jsr:@dreamer/middleware@^1.1.0",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.1.0",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.1.0",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.2.0",
    "@dreamer/render": "jsr:@dreamer/render@^1.5.3",
    "@dreamer/router": "jsr:@dreamer/router@^1.2.2",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/server": "jsr:@dreamer/server@^1.3.0",
    "@dreamer/service": "jsr:@dreamer/service@^1.1.0",
    "@dreamer/utils": "jsr:@dreamer/utils@^1.1.0",
    "@dreamer/view": "jsr:@dreamer/view@^3.0.4",
    "@unocss/core": "npm:@unocss/core@66.0.0",
    "@unocss/preset-wind3": "npm:@unocss/preset-wind3@66.0.0",
    "@unocss/preset-icons": "npm:@unocss/preset-icons@66.0.0",
    "esbuild": "npm:esbuild@0.27.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view"
  }
}
