{
  "name": "dweb-example-react-csr-advanced",
  "description": "Dweb example (multi-app). Bun: bun run dev:backend | dev:frontend | build:backend | build:frontend | start:backend | start:frontend",
  "private": true,
  "scripts": {
    "dev:backend": "bun run src/backend/main.ts",
    "dev:frontend": "bun run src/frontend/main.ts",
    "build:backend": "bun run src/backend/main.ts -- --build",
    "build:frontend": "bun run src/frontend/main.ts -- --build",
    "start:backend": "bun run dist/backend/server.js",
    "start:frontend": "bun run dist/frontend/server.js"
  },
  "dependencies": {
    "@dreamer/dweb": "file:../../../",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.0.18",
    "tailwindcss": "4.2.0"
  }
}