{
  "tasks": {
    "dev:backend": "deno run -A src/backend/main.ts",
    "dev:frontend": "deno run -A src/frontend/main.ts",
    "build:backend": "deno run -A src/backend/main.ts --build",
    "build:frontend": "deno run -A src/frontend/main.ts --build",
    "start:backend": "deno run -A dist/backend/server.js",
    "start:frontend": "deno run -A dist/frontend/server.js"
  },
  "imports": {
    "@common/": "./src/common/",
    "@backend/": "./src/backend/",
    "@frontend/": "./src/frontend/",
    "@dreamer/config": "jsr:@dreamer/config@^1.0.0-beta.6",
    "@dreamer/console": "jsr:@dreamer/console@^1.0.3-beta.10",
    "@dreamer/database": "jsr:@dreamer/database@^1.0.0-beta.10",
    "@dreamer/dweb": "../../../src/mod.ts",
    "@dreamer/esbuild": "jsr:@dreamer/esbuild@^1.0.0-beta.64",
    "@dreamer/lifecycle": "jsr:@dreamer/lifecycle@^1.0.0-beta.3",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.0.0-beta.10",
    "@dreamer/middleware": "jsr:@dreamer/middleware@^1.0.0-beta.4",
    "@dreamer/middlewares": "jsr:@dreamer/middlewares@^1.0.0-beta.6",
    "@dreamer/plugin": "jsr:@dreamer/plugin@^1.0.0-beta.6",
    "@dreamer/plugins": "jsr:@dreamer/plugins@^1.0.0-beta.16",
    "@dreamer/render": "jsr:@dreamer/render@^1.0.0-beta.18",
    "@dreamer/router": "jsr:@dreamer/router@^1.0.0-beta.11",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.0.0-beta.26",
    "@dreamer/server": "jsr:@dreamer/server@^1.0.0-beta.26",
    "@dreamer/service": "jsr:@dreamer/service@^1.0.0-beta.4",
    "@dreamer/utils": "jsr:@dreamer/utils@^1.0.0-beta.8",

    "preact": "npm:preact@10.28.0",
    "preact/hooks": "npm:preact@10.28.0/hooks",
    "preact/jsx-runtime": "npm:preact@10.28.0/jsx-runtime",
    "preact-render-to-string": "npm:preact-render-to-string@6.5.0",

    "postcss": "npm:postcss@8.4.39",
    "autoprefixer": "npm:autoprefixer@10.4.19",
    "cssnano": "npm:cssnano@7.0.3",
    "tailwindcss": "npm:tailwindcss@4.1.18",

    "esbuild": "npm:esbuild@0.27.2"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
